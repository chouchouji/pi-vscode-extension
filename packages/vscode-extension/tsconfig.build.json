{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"inlineSources": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"sourceMap": false,
		"paths": {
			"@earendil-works/pi-coding-agent": ["../coding-agent/dist/index.d.ts"],
			"@earendil-works/pi-coding-agent/*": ["../coding-agent/dist/*.d.ts"],
			"@earendil-works/pi-mcp-adapter": ["../mcp-adapter/dist/index.d.ts"],
			"@earendil-works/pi-mcp-adapter/*": ["../mcp-adapter/dist/*.d.ts"]
		},
		"types": ["node", "vscode"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
