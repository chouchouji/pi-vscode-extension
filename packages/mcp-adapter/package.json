{
	"name": "@earendil-works/pi-mcp-adapter",
	"version": "0.81.1",
	"description": "MCP adapter extension for Pi coding agent",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx cp src/app-bridge.bundle.js src/banner.png src/mcp-keyring-helper.cjs src/mcp-script-worker.mjs dist/ && shx cp -r src/skills dist/skills",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		],
		"skills": [
			"./dist/skills"
		]
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@earendil-works/pi-tui": "^0.81.1",
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/core": "2.0.0",
		"@modelcontextprotocol/ext-apps": "1.7.5",
		"@napi-rs/keyring": "1.3.0",
		"ajv": "8.17.1",
		"ajv-formats": "3.0.1",
		"cross-spawn": "7.0.6",
		"open": "10.2.0",
		"recheck": "4.5.0",
		"smol-toml": "1.6.1",
		"strip-json-comments": "5.0.3",
		"typebox": "1.1.38",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3"
	}
}
